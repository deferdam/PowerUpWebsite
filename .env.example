# Copie ce fichier en .env pour le développement local (jamais commité).
# Sur Vercel : Project > Settings > Environment Variables.

# Mot de passe du tableau de bord /admin (12 caractères minimum, sinon /admin reste fermé)
ADMIN_PASSWORD=

# Secret aléatoire de 32 caractères minimum (signe le cookie admin et hache les IP du rate limit)
# Génère-le avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Base Turso. Ajoutées automatiquement par l'intégration Turso de Vercel.
# À la création de la base Turso, choisir une région UE (ex. Francfort aws-eu-central-1, ou Irlande aws-eu-west-1) : la page Confidentialité l'affirme.
# Attention : en local, mettre ici les identifiants de production fait écrire tes tests dans la vraie base.
# En local, laisser vide = fichier local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
